# Example settings for MKShop MCP Community. Do not commit a real .env file.
# The default mode is local only, with ports 18999 (MCP) and 18998 (control panel).
# Set environment variables before launching Node; early imports can read them.
#
# GATEKEEPER_PORT=18999
# PANEL_PORT=18998
# MCP_SKIP_BROWSER_OPEN=1
#
# MCP_DATA_DIR=D:/My-Isolated-Workspace
# AKI_MCP_DATA_DIR=D:/My-Private-MCP-Profile
#
# Default = no Tailscale Funnel, no update check.
# MKSHOP_ENABLE_FUNNEL=0
# MKSHOP_ENABLE_UPDATE_CHECK=0
#
# Remote use requires careful configuration and OAuth review.
# PUBLIC_ORIGIN=https://your-authenticated-domain.example
# PASEO_CLI_JS=D:/Optional-CLI/bin/paseo
